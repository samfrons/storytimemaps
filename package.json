{
  "name": "storymap-cluster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "plaques:web": "node scripts/generate-premium-plaques.js",
    "plaques:cut": "node scripts/generate-lightburn-plaque.js",
    "plaques:verify": "node scripts/verify-plaques.js",
    "plaques": "pnpm run plaques:web && pnpm run plaques:cut && pnpm run plaques:verify"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.84.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/supercluster": "^7.1.3",
    "i18next": "^25.4.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "mapbox-gl": "^3.14.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.0",
    "next-i18next": "^15.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.7.0",
    "react-map-gl": "^8.0.4",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.16.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsqr": "^1.4.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.6.2"
  }
}
