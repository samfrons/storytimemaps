# Copy this file to .env.local and fill in your values

# Mapbox Configuration
# Get your token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Database Configuration
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
DATABASE_URL=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/storymaps?retryWrites=true&w=majority

# Authentication Configuration
# NextAuth.js secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32

# NextAuth URL - your app's base URL
NEXTAUTH_URL=http://localhost:3000

# IMPORTANT: For production deployment
# Set these variables in your deployment platform's environment variables:
# - Vercel: Project Settings > Environment Variables
# - Netlify: Site Settings > Environment Variables
# - Railway: Variables tab
# - Heroku: Config Vars
#
# Never commit production secrets to your repository!
