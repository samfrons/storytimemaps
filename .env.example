# Copy this file to .env.local and fill in your values

# Mapbox Configuration
# Get your token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase Service Role Key (for admin operations only)
# WARNING: Keep this secret! Only use server-side.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# IMPORTANT: For production deployment
# Set all environment variables in your deployment platform's environment variables:
# - Vercel: Project Settings > Environment Variables
# - Netlify: Site Settings > Environment Variables
# - Railway: Variables tab
# - Heroku: Config Vars
#
# Never commit production secrets to your repository!
